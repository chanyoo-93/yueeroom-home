{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ImageUpload",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::yueeroom-assets/products/*"
    },
    {
      "Sid": "SESendEmail",
      "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": "arn:aws:ses:ap-northeast-2:*:identity/yueeroom.com"
    }
  ]
}
