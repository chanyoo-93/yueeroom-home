# =============================================================================
# 유이룸 (Yu-ee Room) 환경변수 템플릿
# 이 파일을 복사하여 .env 또는 .env.local 로 사용하세요.
# ⚠ 실제 값이 담긴 .env 파일은 절대 Git에 커밋하지 마세요.
# =============================================================================

# ──────────────────────────────────────────────────────────
# 공통
# ──────────────────────────────────────────────────────────
NODE_ENV=development

# ──────────────────────────────────────────────────────────
# Frontend (apps/frontend/.env.local)
# ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_KCP_SDK_URL=https://your-kcp-sdk-url.example/sdk.js

# ──────────────────────────────────────────────────────────
# Backend (apps/backend/.env)
# ──────────────────────────────────────────────────────────

# 서버
PORT=4000
FRONTEND_URL=http://localhost:3000

# 데이터베이스 (PostgreSQL)
POSTGRES_USER=yueeroom
POSTGRES_PASSWORD=yueeroom_dev_password
POSTGRES_DB=yueeroom_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://yueeroom:yueeroom_dev_password@localhost:5432/yueeroom_db

# 캐시 (Redis)
REDIS_URL=redis://localhost:6379
# docker compose 전용 Redis 개별 설정
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=yueeroom_redis_password

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# AWS
# 운영(ECS): AWS_ACCESS_KEY_ID/SECRET 불필요 — ECS Task Role이 자동으로 사용됨
# 로컬 개발: AWS CLI 프로필(aws configure --profile yueeroom)을 사용하거나
#           아래 변수를 .env에만 직접 설정 (절대 Git에 커밋하지 마세요)
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-northeast-2

# AWS S3 (이미지 스토리지)
S3_BUCKET_NAME=yueeroom-assets
CDN_URL=https://cdn.yueeroom.com

# AWS SES (이메일)
SES_FROM_EMAIL=noreply@yueeroom.com
ADMIN_EMAIL=admin@yueeroom.com

# 모니터링 - Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# 결제 - KCP 이지페이
KCP_SITE_CODE=your-kcp-site-code
KCP_SITE_KEY=your-kcp-site-key
KCP_SANDBOX=true
KCP_WEBHOOK_SECRET=your-kcp-webhook-secret
# KCP 문서로 서명 방식 확정 전 로컬 webhook 테스트가 필요할 때만 true
KCP_WEBHOOK_SIGNATURE_DISABLED=false

# 결제 - Naver Pay
NAVER_PAY_CHAIN_ID=your-naver-pay-chain-id

# 결제 - KakaoPay
KAKAO_PAY_SECRET_KEY=your-kakao-pay-secret-key
KAKAO_PAY_CID=TC0ONETIME

# 소셜 로그인 - Naver
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
NAVER_CALLBACK_URL=http://localhost:4000/api/auth/naver/callback

# 소셜 로그인 - Kakao
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_CALLBACK_URL=http://localhost:4000/api/auth/kakao/callback
