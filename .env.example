# =============================================================================
# 유이룸 (Yu-ee Room) 환경변수 템플릿
# 이 파일을 복사하여 .env 또는 .env.local 로 사용하세요.
# ⚠ 실제 값이 담긴 .env 파일은 절대 Git에 커밋하지 마세요.
# =============================================================================

# ──────────────────────────────────────────────────────────
# 공통
# ──────────────────────────────────────────────────────────
NODE_ENV=development

# ──────────────────────────────────────────────────────────
# Frontend (apps/frontend/.env.local)
# ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ──────────────────────────────────────────────────────────
# Backend (apps/backend/.env)
# ──────────────────────────────────────────────────────────

# 서버
PORT=4000
FRONTEND_URL=http://localhost:3000

# 데이터베이스 (PostgreSQL)
POSTGRES_USER=yueeroom
POSTGRES_PASSWORD=yueeroom_dev_password
POSTGRES_DB=yueeroom_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://yueeroom:yueeroom_dev_password@localhost:5432/yueeroom_db

# 캐시 (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=yueeroom_redis_password

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# AWS
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# AWS S3 (이미지 스토리지)
AWS_S3_BUCKET_NAME=yueeroom-assets

# AWS SES (이메일)
AWS_SES_FROM_EMAIL=noreply@yueeroom.com

# 결제 - Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# 결제 - Naver Pay
NAVER_PAY_CLIENT_ID=your-naver-pay-client-id
NAVER_PAY_CLIENT_SECRET=your-naver-pay-client-secret
NAVER_PAY_CHAIN_ID=your-naver-pay-chain-id

# 결제 - KakaoPay
KAKAO_PAY_APP_ADMIN_KEY=your-kakao-pay-admin-key
KAKAO_PAY_CID=TC0ONETIME

# 소셜 로그인 - Naver
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# 소셜 로그인 - Kakao
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
